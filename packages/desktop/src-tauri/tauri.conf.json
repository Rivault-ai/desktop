{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Rivault",
  "version": "0.3.0",
  "identifier": "ai.rivault.daemon",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Rivault",
        "width": 900,
        "height": 640,
        "minWidth": 720,
        "minHeight": 480
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app"],
    "category": "DeveloperTool",
    "shortDescription": "Local secrets daemon for AI agents",
    "longDescription": "Rivault is a zero-knowledge encrypted secrets vault for AI agents. The desktop daemon watches agent transcripts on this machine and scrubs released vault values after every task.",
    "copyright": "Copyright (c) 2026 Rivault",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "11.0"
    }
  }
}
